<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>PRV Systems — Embedded IoT & 3D Printing</title>
  <meta name="description" content="Engineering-driven IoT systems, reliable hardware, firmware, 3D-printing and modeling.">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800;900&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="assets/css/style.css?v=30">

<style>
  /* ================= DIRECT HOME FIX ================= */

  @media (min-width: 761px) {
    html,
    body.home-page {
      width: 100%;
      height: 100dvh;
      min-height: 100dvh;
      max-height: 100dvh;
      overflow: hidden !important;
    }

    body.home-page {
      margin: 0 !important;
      display: grid !important;
      grid-template-rows: minmax(0, 1fr) 46px !important;
    }

    .home-page main {
      height: 100% !important;
      min-height: 0 !important;
      overflow: hidden !important;
    }

    .home-page .hero {
      width: 100% !important;
      height: 100% !important;
      min-height: 0 !important;
      padding: 18px 5.6vw 54px !important;
      display: grid !important;
      grid-template-columns: minmax(300px, 0.82fr) minmax(420px, 1.18fr) !important;
      gap: clamp(26px, 4vw, 70px) !important;
      align-items: center !important;
      overflow: hidden !important;
      box-sizing: border-box !important;
    }

    .home-page .hero-left {
      width: 100% !important;
      min-height: 0 !important;
      transform: translateY(-42px) !important;
    }

    .home-page .hero-logo {
      margin-bottom: 10px !important;
    }

    .home-page .hero-logo img {
      width: 145px !important;
      height: auto !important;
    }

    .home-page .hero-left h1 {
      max-width: 560px !important;
      font-size: 44px !important;
      line-height: 0.82 !important;
      letter-spacing: -0.065em !important;
      margin: 0 !important;
    }

    .home-page .subtitle {
      margin-top: 14px !important;
      max-width: 520px !important;
      font-size: 13px !important;
      line-height: 1.35 !important;
    }

    .home-page .cta-group {
      margin-top: 16px !important;
      gap: 12px !important;
      padding-bottom: 20px !important;
      position: relative !important;
      z-index: 20 !important;
    }

    .home-page .cta {
      min-height: 34px !important;
      padding: 7px 18px !important;
      font-size: 12px !important;
    }

    .home-page .hero-right {
      width: 100% !important;
      height: 100% !important;
      min-height: 0 !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
    }

    .home-page .floating-card {
      width: min(100%, 700px) !important;
      height: min(45vh, 370px) !important;
      max-height: 370px !important;
    }

    .home-page .bg-text {
      font-size: 140px !important;
    }

    .home-page .site-footer {
      height: 46px !important;
      min-height: 46px !important;
      margin-top: 0 !important;
      padding: 0 20px !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      box-sizing: border-box !important;
    }

    .home-page .footer-content {
      font-size: 11px !important;
    }
  }

  @media (min-width: 761px) and (max-height: 820px) {
    body.home-page {
      grid-template-rows: minmax(0, 1fr) 42px !important;
    }

    .home-page .hero {
      padding-top: 12px !important;
      padding-bottom: 58px !important;
    }

    .home-page .hero-left {
      transform: translateY(-58px) !important;
    }

    .home-page .hero-logo img {
      width: 135px !important;
    }

    .home-page .hero-left h1 {
      font-size: 38px !important;
      line-height: 0.8 !important;
    }

    .home-page .subtitle {
      margin-top: 10px !important;
      font-size: 12px !important;
      line-height: 1.28 !important;
    }

    .home-page .cta-group {
      margin-top: 12px !important;
      padding-bottom: 30px !important;
    }

    .home-page .cta {
      min-height: 32px !important;
      padding: 6px 16px !important;
      font-size: 12px !important;
    }

    .home-page .floating-card {
      height: min(42vh, 330px) !important;
      max-height: 330px !important;
    }

    .home-page .site-footer {
      height: 42px !important;
      min-height: 42px !important;
    }
  }

  @media (max-width: 760px) {
    html,
    body.home-page {
      height: auto !important;
      min-height: 100svh !important;
      max-height: none !important;
      overflow-x: hidden !important;
      overflow-y: auto !important;
    }

    body.home-page {
      display: flex !important;
      flex-direction: column !important;
    }

    .home-page main {
      height: auto !important;
      overflow: visible !important;
    }

    .home-page .hero {
      height: auto !important;
      min-height: 100svh !important;
      display: flex !important;
      overflow: visible !important;
    }

    .home-page .site-footer {
      height: auto !important;
      min-height: auto !important;
      padding: 22px 20px !important;
    }
  }
</style>

<script src="assets/js/main.js" defer></script>
  <script src="assets/js/main.js" defer></script>
</head>

<body class="home-page">
  <main>
    <div class="lang-switch fixed" id="langSwitch">
      <button class="lang-current" id="langCurrent" type="button" aria-haspopup="listbox" aria-expanded="false">
        <span class="lang-label" id="currentLang">UK</span>

        <svg class="lang-caret" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M7 10l5 5 5-5"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </button>

      <div class="lang-menu" role="listbox">
        <button class="lang-item" type="button" data-lang="uk" aria-selected="true">
          <span class="lang-text">Українська</span>
        </button>

        <button class="lang-item" type="button" data-lang="en" aria-selected="false">
          <span class="lang-text">English</span>
        </button>
      </div>
    </div>

    <section class="hero">
      <div class="hero-left">
        <a class="hero-logo" href="./" aria-label="PRV Systems home">
          <img src="assets/img/prv_logo.png" alt="PRV Systems Logo" width="220" height="90">
        </a>

        <h1>
          EMBEDDED<br>
          SOLUTIONS<br>
          IoT<br>
          3D-PRINTING<br>
          MODELING
        </h1>

        <p class="subtitle">
          Engineering-driven IoT systems.<br>
          Development reliable hardware &amp; firmware.<br>
          3D-Printing &amp; Modeling.
        </p>

        <div class="cta-group">
          <a href="about/index.html" class="cta">About</a>

          <button type="button" class="cta secondary" id="openContacts">
            Contact me
          </button>
        </div>
      </div>

      <div class="hero-right">
        <div class="bg-text">
          IOT<br>
          R&amp;D
        </div>

        <div class="floating-card">
          <img src="assets/img/hero-image.jpg" alt="Engineering" width="900" height="620">
        </div>
      </div>
    </section>

    <div class="modal-backdrop" id="contactModal" aria-hidden="true">
      <div class="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
        <div class="modal-header">
          <div class="modal-title" id="modalTitle">Contact me</div>

          <button class="modal-close" id="closeContacts" type="button" aria-label="Close contact form">
            ✕
          </button>
        </div>

        <div class="modal-body">
          <div class="modal-hint">
            Send a message — it will be delivered to me.
          </div>

          <form id="contactForm" action="https://formspree.io/f/meelzrvv" method="POST">
            <div class="form-grid">
              <input class="field" name="name" type="text" placeholder="Your name" autocomplete="name" required>
              <input class="field" name="email" type="email" placeholder="Email" autocomplete="email" required>
              <textarea class="field" name="message" placeholder="Message" required></textarea>
            </div>

            <input type="hidden" name="_subject" value="New message from portfolio site">

            <div class="modal-actions">
              <button class="btn btn-ghost" id="cancelBtn" type="button">Cancel</button>
              <button class="btn btn-primary" type="submit">Send</button>
            </div>

            <div class="status" id="status" role="status" aria-live="polite"></div>
          </form>
        </div>
      </div>
    </div>
  </main>

  <footer class="site-footer">
    <div class="footer-content">
      © 2026 PRV-systems. All rights reserved.
    </div>
  </footer>
</body>
</html>